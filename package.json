{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "workspaces": [
    "extensions/*"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@xterm/headless": "6.0.0",
    "esbuild": "0.28.2",
    "typebox": "*"
  },
  "scripts": {
    "build": "npx esbuild extensions/*/*.ts --bundle --platform=node --format=esm --packages=external --outbase=. --outdir=.",
    "test": "node --experimental-strip-types --test extensions/*/test-*.mjs test/*.test.mjs",
    "pretest:live": "npm run build",
    "test:live": "node --experimental-strip-types --test test/live/*.test.mjs",
    "pretest": "npm run build"
  },
  "pi": {
    "extensions": [
      "./extensions/prefix-stabilizer/prefix-stabilizer.ts",
      "./extensions/compaction-cache/compaction-cache.ts",
      "./extensions/focus-mode/focus-mode.ts",
      "./extensions/interrupt-steer/interrupt-steer.ts",
      "./extensions/quick-cancel/quick-cancel.ts",
      "./extensions/prompt-drafts/prompt-drafts.ts",
      "./extensions/image-thumbnails/image-thumbnails.ts",
      "./extensions/context-redact/context-redact.ts",
      "./extensions/footer/footer.ts"
    ],
    "skills": [
      "./extensions/context-redact/skills"
    ]
  }
}
